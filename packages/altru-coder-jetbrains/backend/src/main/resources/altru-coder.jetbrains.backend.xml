<idea-plugin>
    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="intellij.platform.kernel.backend"/>
        <module name="altru-coder.jetbrains.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <platform.rpc.backend.remoteApiProvider implementation="ai.altrucoder.backend.rpc.AltruCoderAppRpcApiProvider"/>
        <platform.rpc.backend.remoteApiProvider implementation="ai.altrucoder.backend.rpc.AltruCoderProjectRpcApiProvider"/>
        <platform.rpc.backend.remoteApiProvider implementation="ai.altrucoder.backend.rpc.AltruCoderSessionRpcApiProvider"/>
    </extensions>
</idea-plugin>
