<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="altru-coder.jetbrains.shared"/>
    </dependencies>

    <resource-bundle>messages.AltruCoderBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Altru Coder"
                    anchor="left"
                    icon="/icons/altru.svg"
                    factoryClass="ai.altrucoder.client.AltruCoderToolWindowFactory"/>

        <registryKey key="altru-coder.session.condense"
                     description="Enable event condensing in the session update queue (merges redundant snapshots before model delivery)."
                     defaultValue="true"
                     restartRequired="false"
                     overrides="false"/>
        <registryKey key="altru-coder.session.flushMs"
                     description="Session update queue flush cadence in milliseconds."
                     defaultValue="150"
                     restartRequired="false"
                     overrides="false"/>
    </extensions>

    <actions>
        <action id="Altru Coder.Restart"
                class="ai.altrucoder.client.actions.RestartAltruCoderAction"/>

        <action id="Altru Coder.Reinstall"
                class="ai.altrucoder.client.actions.ReinstallAltruCoderAction"/>

        <group id="Altru Coder.SettingsGroup">
            <reference ref="Altru Coder.Restart"/>
            <reference ref="Altru Coder.Reinstall"/>
        </group>

        <action id="Altru Coder.Settings"
                class="ai.altrucoder.client.actions.AltruCoderSettingsAction"
                icon="AllIcons.General.GearPlain"/>

        <action id="Altru Coder.SendPrompt"
                class="ai.altrucoder.client.actions.SendPromptAction"
                text="Send Prompt"
                description="Send the current Altru Coder prompt">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="ENTER"/>
        </action>

        <action id="Altru Coder.StopSession"
                class="ai.altrucoder.client.actions.StopSessionAction"
                text="Stop Session"
                description="Stop the current Altru Coder session">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="alt S"/>
        </action>
    </actions>
</idea-plugin>
