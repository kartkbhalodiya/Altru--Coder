name: altru-coder

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

jobs:
  altru-coder:
    if: |
      (github.event.comment.author_association == 'MEMBER' || github.event.comment.author_association == 'OWNER') &&
      (
        contains(github.event.comment.body, ' /kc') ||
        startsWith(github.event.comment.body, '/kc') ||
        contains(github.event.comment.body, ' /altru') ||
        startsWith(github.event.comment.body, '/altru')
      )
    runs-on: blacksmith-4vcpu-ubuntu-2404
    permissions:
      id-token: write
      contents: read
      pull-requests: read
      issues: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - uses: ./.github/actions/setup-bun

      - name: Run opencode
        uses: Altru-Coder/altrucoder/github@latest
        env:
          ALTRU_CODER_API_KEY: ${{ secrets.ALTRU_CODER_API_KEY }}
          ALTRU_CODER_ORG_ID: ${{ secrets.ALTRU_CODER_ORG_ID }}
          ALTRU_CODER_PERMISSION: '{"bash": "deny"}'
        with:
          model: altru-coder/altru-auto/frontier
